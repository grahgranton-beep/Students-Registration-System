# ─────────────────────────────────────────────────────────────────────────────
# Student Registration System — Backend Environment Variables
# Copy this file to .env and fill in real values for local development
# NEVER commit .env to git — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Security Keys ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_64_char_random_hex_string

# ── Database ──────────────────────────────────────────────────────────────────
# Production: Get this from Neon.tech or Supabase (free PostgreSQL)
# Local development: Leave blank to use local SQLite (students_registration.db)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── CORS / Frontend URL ───────────────────────────────────────────────────────
# Set this to your Vercel deployment URL after deploying the frontend
# FRONTEND_URL=https://your-app-name.vercel.app
